{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.vibebox/login/**)",
      "Read(~/.vibebox/llm.env)",
      "Read(~/.local/share/opencode/**)",
      "Read(~/projects_linux/no-sniff/**)",
      "Read(**/.vibe/**)",
      "Edit(~/.claude/escape-pass.json)",
      "Edit(~/.claude/vibe-escape.py)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Edit(**/.claude/settings*.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/settings*.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "api.scaleway.ai"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.kube",
        "~/.docker",
        "~/.vibebox/login",
        "~/.vibebox/llm.env",
        "~/.local/share/opencode",
        "~/projects_linux/no-sniff"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/vibe-escape.py hook-pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/vibe-escape.py hook-post",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/vibe-escape.py session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
