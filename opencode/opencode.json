{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "typescript": {
      "disabled": true
    },
    "ty": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI-compatible (llama.cpp / Ollama / hosted)",
      "options": {
        "baseURL": "{env:LOCAL_LLM_URL}",
        "apiKey": "{env:LOCAL_LLM_API_KEY}"
      },
      "models": {
        "{env:LOCAL_LLM_MODEL}": {
          "name": "{env:LOCAL_LLM_MODEL}",
          "limit": { "context": 100000, "output": 8192 }
        }
      }
    }
  },
  "model": "local/{env:LOCAL_LLM_MODEL}"
}
